# Основные настройки
DEBUG=True
# Режим тестирования (использование мок-сервисов вместо реальных API)
USE_MOCK_SERVICES=True

# Firebase
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json
FIREBASE_DATABASE_URL=https://guatefit-xxxx.firebaseio.com

# Postgres
POSTGRES_USER=guatefit
POSTGRES_PASSWORD=guatefit_password
POSTGRES_DB=guatefit

# default db engin
DB_ENGINE=postgres

# WhatsApp API (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/whatsapp/webhook

# Telegram API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# https://api.telegram.org/bot<BOT_TOKEN>/setWebhook?url=https://ваш-домен/api/messaging/webhook/telegram
TELEGRAM_ADMIN_BOT_TOKEN=your_telegram_admin_bot_token_here
TELEGRAM_RETRY_INTERVAL_SECONDS=300
TELEGRAM_MAX_MESSAGE_SIZE=4000
TELEGRAM_MAX_MESSAGE_AGE_HOURS=72

# Ngrok
NGROK_AUTHTOKEN=your-auth-token

# LLM настройки
LLM_PROVIDER=hybrid  # openai, deepseek или hybrid

# Маппинг задач для гибридного режима, в формате JSON
# {"diet_plan": "openai", "nutrition_question": "deepseek", "shopping_list": "deepseek"}
LLM_TASK_MAPPING={"diet_plan": "openai", "nutrition_question": "deepseek", "shopping_list": "deepseek"}

# OpenAI
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-3.5-turbo

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

